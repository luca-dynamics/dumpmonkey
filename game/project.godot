; DumpMonkey Racing — Godot 4.7.2, Compatibility renderer.
config_version=5

[application]
config/name="DumpMonkey Racing"
run/main_scene="res://crew_yard.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Crew Yard — ride with the crew."
config/icon="res://assets/brand/crew-symbol.png"
boot_splash/bg_color=Color(0.067, 0.098, 0.118, 1)
boot_splash/image="res://assets/brand/crew-logo.png"
boot_splash/stretch_mode=0

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
environment/defaults/default_clear_color=Color(0.15, 0.19, 0.22, 1)
anti_aliasing/quality/msaa_3d=2

[physics]
common/physics_ticks_per_second=60
3d/physics_engine="GodotPhysics3D"

[audio]
driver/enable_input=false
